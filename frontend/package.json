{
  "name": "video-scanner-go-frontend",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node ../scripts/check-web-build.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json && node ../scripts/check-config-sync.mjs",
    "check:web-build": "node ../scripts/check-web-build.mjs",
    "check:config-sync": "node ../scripts/check-config-sync.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
